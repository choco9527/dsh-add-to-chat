{
  "name": "dsh-add-to-chat",
  "version": "0.1.0",
  "description": "Add selected DSH assistant text to the composer as a structured reference.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm run build && node --check client.js && pnpm test",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "chat",
    "selection"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7 || ^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  }
}
